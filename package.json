{
  "name": "mcp-gatekeeper-experiment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "generate": "node scripts/generate-validators.mjs && node scripts/build-configurator.mjs && cf workers types --include-runtime",
    "prebuild": "npm run generate",
    "build": "cf build",
    "predev": "npm run generate",
    "dev": "cf dev",
    "typecheck": "cf workers types --include-runtime && tsc --noEmit && tsc --project tsconfig.browser.json",
    "test": "tsx --test test/*.test.ts",
    "test:runtime": "tsx test/runtime.ts",
    "test:live": "tsx scripts/live-smoke.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "capnweb": "^0.12.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/node": "^26.6.5",
    "cf": "^1.0.0-beta.18",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261012.0-beta",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
