{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "ESNext.Disposable"],
    "types": [],
    "strict": true, "skipLibCheck": true, "resolveJsonModule": true,
    "allowImportingTsExtensions": true, "noEmit": true, "allowJs": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", ".cloudflare/types/index.d.ts"],
  "exclude": ["src/configurator/client.ts"]
}
